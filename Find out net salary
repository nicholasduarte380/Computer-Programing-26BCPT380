#include<stdio.h>

int main()
{
    int gross,allowances,deductions,net;

    printf("Enter gross salary: ");
    scanf("%d",&gross);

    if(gross>10000)
    {
        allowances=gross*10/100;
        deductions=gross*3/100;
    }
    else if(gross>5000)
    {
        allowances=gross*7/100;
        deductions=gross*2/100;
    }
    else
    {
        allowances=0;
        deductions=0;
    }

    net=gross+allowances-deductions;

    printf("Gross salary = %d\n",gross);
    printf("Allowances = %d\n",allowances);
    printf("Deductions = %d\n",deductions);
    printf("Net salary = %d",net);

    return 0;
}