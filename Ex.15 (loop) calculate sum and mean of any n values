#include<stdio.h>

int main()
{
    int i,n,value,sum=0;
    int mean;

    printf("Enter number of values: ");
    scanf("%d",&n);

    for(i=1; i<=n; i++)
    {
        printf("Enter value %d: ",i);
        scanf("%d",&value);

        sum=sum+value;
    }

    mean=sum/n;

    printf("Sum = %d\n",sum);
    printf("Mean = %d",mean);

    return 0;
}